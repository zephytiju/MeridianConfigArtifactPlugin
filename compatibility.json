    "NativeQuery",
    "provider SDK imports",
    "bootstrap configuration",
    "service endpoints",
    "physical locators"
  ],
  "dependencyCompatibility": {
    "meridian-storage-core": ">=1.1.0,<2",
    "meridian-storage-object-common": ">=1.0.3,<2",
    "meridian-storage-query": ">=1.0.3,<2",
    "meridian-storage-semantics": ">=2.0.1,<3"
  },
  "validationPolicy": "releasedDependencies and optionalConformance record a tested closure, not runtime allowlists. Exact public hashes are in requirements-validation.txt. Untested combinations remain unverified."
}

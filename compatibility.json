{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "formatVersion": "meridian.plugin.compatibility.v1",
  "distribution": "meridian-plugin-config-artifact",
  "version": "1.1.2",
  "python": ">=3.12,<3.15",
  "coreContract": "1.x",
  "pluginContract": "1.0.0",
  "lockedDesign": {
    "hldRevision": 114,
    "catalogsPublicInterfacesRevision": 127,
    "engineAdaptersRevision": 24,
    "kafkaStreamingLldRevision": 6,
    "meridianConstructsRevision": 113,
    "configArtifactLldRevision": 48
  },
  "releasedDependencies": {
    "meridian-storage-core": "1.1.0",
    "meridian-storage-object-common": "1.0.3",
    "meridian-storage-query": "1.0.3",
    "meridian-storage-semantics": "2.0.1"
  },
  "optionalConformance": {
    "meridian-storage-s3": "1.0.4",
    "meridian-storage-oci": "1.1.0"
  },
  "catalogsConsumed": [
    "object",
    "structured"
  ],
  "catalogsDefined": [],
  "excluded": [
